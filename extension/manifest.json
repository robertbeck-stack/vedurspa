{
  "manifest_version": 3,
  "name": "Veðurvaktin AI – Viðbót fyrir vedur.is",
  "version": "1.0.0",
  "description": "Bætir rauntíma spágæðamati, nákvæmniseinkunnum og AI-leiðréttri veðurspá beint inn á vefsíðu vedur.is",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Veðurvaktin AI Greining",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://www.vedur.is/*",
    "https://vedur.is/*",
    "https://vedurspa-eta.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.vedur.is/*",
        "https://vedur.is/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
